# Alle Werte hier sind PFLICHT (keine Defaults im Code) und werden strikt über
# os.environ.get() eingelesen. In Unraid trägst du sie stattdessen direkt im
# Container-Template unter "Edit" ein, siehe README/Erklärung.

DISCORD_TOKEN=dein-bot-token-hier

# Web-Dashboard (OAuth2)
DISCORD_CLIENT_ID=deine-client-id
DISCORD_CLIENT_SECRET=dein-client-secret
DISCORD_REDIRECT_URI=http://localhost:5000/callback
FLASK_SECRET_KEY=bitte-durch-einen-zufaelligen-wert-ersetzen

# Interne Bot-API (Dashboard -> Bot, für den Embed-Generator).
# Geteiltes Geheimnis, muss identisch sein (gleicher Container, zwei Prozesse).
INTERNAL_API_SECRET=bitte-durch-einen-zufaelligen-wert-ersetzen

# Optional, sinnvolle Defaults sind im Code hinterlegt:
# BOT_API_HOST=0.0.0.0
# BOT_API_PORT=8080
# BOT_API_URL=http://127.0.0.1:8080
# FLASK_PORT=5000
# DB_PATH=/app/data/database.db
# OAUTH_INSECURE_TRANSPORT=1   # auf 0 setzen, falls ein HTTPS-Reverse-Proxy davor steht
